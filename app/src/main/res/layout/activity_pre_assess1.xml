<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prebg1">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="212dp"
            android:layout_height="212sp"
            android:layout_marginTop="90sp"
            android:layout_marginStart="16sp"
            android:layout_marginEnd="16sp"
            android:layout_gravity="center"
            android:contentDescription="@string/logo_description"
            android:layout_centerHorizontal="true"
            app:srcCompat="@drawable/final_logo" />

        <TextView
            android:id="@+id/preinstruc1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/imageView"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="9sp"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:text="@string/instruc"
            android:textColor="@color/WBlue"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Motivational Text -->
        <TextView
            android:id="@+id/motivationalText"
            android:layout_width="330sp"
            android:layout_height="wrap_content"
            android:layout_below="@id/preinstruc1"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="35sp"
            android:layout_marginStart="16sp"
            android:layout_marginEnd="16sp"
            android:fontFamily="@font/poppinsregular"
            android:gravity="center"
            android:text="@string/instrucpreassess"
            android:textColor="@color/WBlue"
            android:textSize="23sp" />

        <Button
            android:id="@+id/prebtnstart1"
            android:layout_width="212dp"
            android:layout_height="63dp"
            android:layout_below="@id/motivationalText"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="50sp"
            android:background="@drawable/preassesbtn"
            android:text="@string/start" />
    </RelativeLayout>

</ScrollView>
