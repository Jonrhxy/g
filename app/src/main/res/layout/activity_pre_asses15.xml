<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/quesbg"
    android:padding="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".YourActivityName">

        <!-- Header with ImageView and TextView -->
        <LinearLayout
            android:id="@+id/foodLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="@string/timee"
                app:srcCompat="@drawable/timer"/>

            <TextView
                android:id="@+id/timer15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/afacadbolditalic"
                android:text="@string/timer1"
                android:textColor="@color/BlckBlue"
                android:textStyle="bold"
                android:textSize="33sp" />
        </LinearLayout>


        <FrameLayout
            android:id="@+id/overlapContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/foodLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="55dp">

            <ImageView
                android:id="@+id/TransPic"
                android:layout_width="350dp"
                android:layout_height="230dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/homebluecurve"/>

            <TextView
                android:id="@+id/questionText15"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textAlignment="center"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/preqeus15"
                android:textColor="@color/WBlue"
                android:textSize="24sp"
                android:textStyle="normal" />
        </FrameLayout>

        <TextView
            android:id="@+id/guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/afacad"
            android:gravity="center"
            android:text="@string/guideRB"
            android:textColor="#6d835b"
            android:textSize="18sp"
            android:textStyle="normal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/overlapContainer" />

        <RadioGroup
            android:id="@+id/radiopreQ15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guide">

            <RadioButton
                android:id="@+id/prebtn1a"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/choicesbg"
                android:fontFamily="@font/poppinsregular"
                android:layout_marginTop="21dp"
                android:minHeight="48dp"
                android:padding="12dp"
                android:paddingStart="10dp"
                android:text="@string/preQ15a"
                android:textColor="@color/BlckYellow"/>

            <RadioButton
                android:id="@+id/prebtn1b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/choicesbg"
                android:fontFamily="@font/poppinsregular"
                android:minHeight="48dp"
                android:padding="12dp"
                android:paddingStart="10dp"
                android:text="@string/preQ15b"
                android:textColor="@color/BlckYellow"/>

            <RadioButton
                android:id="@+id/prebtn1c"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/choicesbg"
                android:fontFamily="@font/poppinsregular"
                android:minHeight="48dp"
                android:padding="12dp"
                android:paddingStart="10dp"
                android:text="@string/preQ15c"
                android:textColor="@color/BlckYellow"/>

            <RadioButton
                android:id="@+id/prebtn1d"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/choicesbg"
                android:fontFamily="@font/poppinsregular"
                android:minHeight="48dp"
                android:padding="12dp"
                android:paddingStart="10dp"
                android:text="@string/preQ15d"
                android:textColor="@color/BlckYellow"/>
        </RadioGroup>

        <LinearLayout
            android:id="@+id/bttnchoice15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/radiopreQ15">

            <Button
                android:id="@+id/preq15"
                android:layout_width="137dp"
                android:layout_height="65dp"
                android:textAllCaps="false"
                android:fontFamily="@font/poppinsregular"
                android:text="@string/submit"
                android:background="@drawable/preassesbtn"
                android:textSize="20sp"
                android:backgroundTint="@null"/>

            <Button
                android:id="@+id/next15"
                android:layout_width="137dp"
                android:layout_height="65dp"
                android:layout_marginStart="30sp"
                android:textAllCaps="false"
                android:fontFamily="@font/poppinsregular"
                android:background="@drawable/preassesbtn2"
                android:text="@string/next"
                android:textSize="20sp"
                android:backgroundTint="@null" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
