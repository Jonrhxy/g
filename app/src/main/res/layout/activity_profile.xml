<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainConstraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/leaderboardsbg"
    tools:context=".MainActivity">

    <!-- TOP BAR SECTION -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="1.0">

        <!-- Back Arrow -->
        <ImageView
            android:id="@+id/imageBackArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/arrow_back"
            app:tint="@android:color/white" />

        <!-- "Profile" Title -->
        <TextView
            android:id="@+id/textProfileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Profile"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Push everything else to the right -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Coin Layout (shows textCoinValue + coin icon) -->
        <LinearLayout
            android:id="@+id/coinLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp">

            <!-- textCoinValue: used to display the user’s coin/points -->
            <TextView
                android:id="@+id/textCoinValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="500"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginEnd="8dp" />

            <!-- imageCoinIcon: clickable coin icon to open the shop -->
            <ImageView
                android:id="@+id/imageCoinIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/coin"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- NOTIFICATION, SETTINGS, SHOP ICONS ON RIGHT -->
    <LinearLayout
        android:id="@+id/iconsOnRightLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/topBarLayout"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Notification Icon -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <ImageView
                android:id="@+id/imageNotificationCircle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="fitCenter"
                android:src="@drawable/circleblue" />
            <ImageView
                android:id="@+id/imageNotification"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:layout_marginBottom="2sp"
                android:layout_marginLeft="-3sp"
                android:src="@drawable/notif" />
        </FrameLayout>

        <!-- Settings Icon -->
        <FrameLayout
            android:id="@+id/settingsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <ImageView
                android:id="@+id/imageSettingsCircle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="fitCenter"
                android:src="@drawable/circleblue" />
            <ImageView
                android:id="@+id/imageSettings"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/setting" />
        </FrameLayout>

        <!-- SHOP Icon -->
        <FrameLayout
            android:id="@+id/shopLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5sp">
            <ImageView
                android:id="@+id/imageShopCircle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="fitCenter"
                android:src="@drawable/circleblue" />
            <ImageView
                android:id="@+id/imageShop"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/store" />
        </FrameLayout>
    </LinearLayout>

    <!-- HEADER CONTAINER (Avatar & Greeting) -->
    <FrameLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_marginTop="38dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBarLayout"
        app:layout_constraintWidth_percent="1.0">
        <ImageView
            android:id="@+id/imageAvatar"
            android:layout_width="320dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/character" />
        <FrameLayout
            android:id="@+id/bubbleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="25dp"
            android:layout_marginTop="45dp">
            <TextView
                android:id="@+id/textGreeting"
                android:layout_width="100sp"
                android:layout_height="70sp"
                android:text="User"
                android:gravity="center"
                android:background="@drawable/bubble"
                android:textColor="@color/BlckYellow"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>

    <!-- SCROLLABLE CONTENT -->
    <ScrollView
        android:id="@+id/scrollViewMainContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/scrollContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- MAIN CONTENT SECTION WITH ROUNDED TOP -->
            <LinearLayout
                android:id="@+id/roundedTopContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bgbluee3"
                android:clipToOutline="true"
                android:orientation="vertical">

                <!-- "My Badge" row -->
                <LinearLayout
                    android:id="@+id/linearBadgeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="15sp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/textMyBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15sp"
                        android:text="@string/badges"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/textSeeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-5sp"
                        android:layout_marginEnd="25sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_semibold_italic"
                        android:text="@string/seeAll"
                        android:textColor="@android:color/white"
                        android:textSize="20sp" />
                </LinearLayout>

                <!-- Horizontal ScrollView for Badges -->
                <HorizontalScrollView
                    android:id="@+id/badgeScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bgbrown"
                    android:clipToPadding="false"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:id="@+id/linearBadgeContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp">
                        <!-- Example Badges -->
                        <ImageView
                            android:layout_width="75dp"
                            android:layout_height="75dp"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/ecogreen" />

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/ecoblue" />

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/ecobrown" />

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/ecogold" />
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- TOP BAR: "Total Points" and "Total Coins" -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:padding="8dp">

                        <!-- "Total Points" block -->
                        <LinearLayout
                            android:layout_width="60sp"
                            android:layout_height="48sp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bgbrown">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/totalP"
                                android:drawableStart="@drawable/thropy"
                                android:drawablePadding="4dp"
                                android:textColor="@color/WRed"
                                android:fontFamily="@font/poppinsmedium"
                                android:textSize="14sp"
                                android:gravity="center"/>

                            <TextView
                                android:id="@+id/textTotalPoints"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/zero"
                                android:textColor="@android:color/white"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:gravity="center"/>
                        </LinearLayout>

                        <!-- "Total Coins" block -->
                        <LinearLayout
                            android:layout_width="60sp"
                            android:layout_height="48sp"
                            android:layout_weight="1"
                            android:layout_marginStart="20sp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bgbrown">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/totalC"
                                android:drawableStart="@drawable/coin"
                                android:drawablePadding="4dp"
                                android:textColor="@color/WRed"
                                android:fontFamily="@font/poppinsmedium"
                                android:textSize="14sp"
                                android:gravity="center"/>

                            <TextView
                                android:id="@+id/totalcoins"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/zero"
                                android:textColor="@android:color/white"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:gravity="center"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ACTIVITY LOG CONTAINER -->
                    <LinearLayout
                        android:id="@+id/activityLogHistoryContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/bgbrown">

                        <Button
                            android:id="@+id/btnActivityLog"
                            android:layout_width="250sp"
                            android:layout_height="50sp"
                            android:layout_gravity="center"
                            android:layout_marginTop="5sp"
                            android:gravity="center"
                            android:background="@drawable/actlogbgg"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/ActLog"
                            android:textColor="@color/BlckYellow"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/actlogtxt"
                            android:layout_width="250sp"
                            android:layout_height="50sp"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_italic"
                            android:text="@string/ActLog1"
                            android:textColor="@color/WRed"
                            android:textSize="15sp"
                            android:layout_marginBottom="12dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Selected Character Section -->
                <LinearLayout
                    android:id="@+id/selectedCharacterContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <!-- Display the currently selected character -->
                    <ImageView
                        android:id="@+id/imageSelectedCharacter"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/character" />

                    <!-- Display the selected character's name -->
                    <TextView
                        android:id="@+id/textSelectedCharacterName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/character1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/WBlue"
                        tools:ignore="HardcodedText" />

                    <!-- Label for unlocked characters -->
                    <TextView
                        android:id="@+id/textUnlockedCharactersLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:text="@string/charmess"
                        android:fontFamily="@font/poppins_italic"
                        android:textSize="16sp"
                        android:layout_marginStart="25sp"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/WBlue"/>

                    <!-- Horizontal RecyclerView for unlocked characters -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerUnlockedChars"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipToPadding="false" />
                </LinearLayout>

                <!-- RadioGroup for Weekly/Monthly toggle -->
                <RadioGroup
                    android:id="@+id/radioGroupTimeRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_gravity="center_horizontal">

                    <RadioButton
                        android:id="@+id/radioWeekly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weekly"
                        android:checked="true"
                        android:textColor="@android:color/white"/>

                    <RadioButton
                        android:id="@+id/radioMonthly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monthly"
                        android:textColor="@android:color/white"/>
                </RadioGroup>

                <!-- BarChart for tracking data -->
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"/>

                <!-- TOWER SECTION -->
                <FrameLayout
                    android:id="@+id/towerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="600dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:clipToPadding="false"
                    android:gravity="center">

                    <!-- 1) The main tower body -->
                    <ImageView
                        android:id="@+id/imageTower"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/tower_circle" />


                    <!-- 3) Current step count (inside the orb) -->
                    <TextView
                        android:id="@+id/textTowerSteps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="35dp"
                        android:text="0"
                        android:textColor="@android:color/white"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <!-- 4) Milestones: from lowest (bottom) to highest (top).
                         Each uses layout_gravity="top|center_horizontal" but
                         the marginTop is set so that 50 is near bottom,
                         10,000 is near the top.
                         Tweak the dp values as needed. -->

                    <!-- 50 (lowest) near bottom -->
                    <TextView
                        android:id="@+id/textMilestone50"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="520dp"
                        android:text="50"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- 200 a bit above 50 -->
                    <TextView
                        android:id="@+id/textMilestone200"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="460dp"
                        android:text="200"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- 500 above 200 -->
                    <TextView
                        android:id="@+id/textMilestone500"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="400dp"
                        android:text="500"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- 1,000 above 500 -->
                    <TextView
                        android:id="@+id/textMilestone1000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="340dp"
                        android:text="1,000"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- 3,000 -->
                    <TextView
                        android:id="@+id/textMilestone3000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="280dp"
                        android:text="3,000"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- 5,000 -->
                    <TextView
                        android:id="@+id/textMilestone5000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="220dp"
                        android:text="5,000"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- 10,000 (highest) near the top -->
                    <TextView
                        android:id="@+id/textMilestone10000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="160dp"
                        android:text="10,000"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <!-- 5) "Fit Tower" label near bottom -->
                    <TextView
                        android:id="@+id/textFitTower"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="20dp"
                        android:text="Fit Tower"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </FrameLayout>


                <!-- Bottom Button -->
                <Button
                    android:id="@+id/bottomButton"
                    android:layout_width="200sp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5sp"
                    android:layout_marginBottom="15dp"
                    android:text="@string/selectChar"
                    android:background="@drawable/btnblue"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/BlckBlue"
                    android:layout_gravity="center_horizontal"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
