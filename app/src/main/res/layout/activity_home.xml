<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/homepageM"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_leaderboard">

        <!-- Top container (banner) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="@drawable/mainbg1">

            <!-- "Home" title -->
            <TextView
                android:id="@+id/tvHomeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="25dp"
                android:text="@string/home"
                android:textColor="@color/WRed"
                android:textSize="30sp"
                android:fontFamily="@font/poppins_bold" />

            <!-- TypeWriterView: rectangular text area on the left -->
            <com.example.cverdetotoo.TypeWriterView
                android:id="@+id/tvWelcome"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="120dp"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_semibold_italic" />

            <!-- Character image on the right -->
            <ImageView
                android:id="@+id/ivMascot"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginTop="24dp"
                android:contentDescription="@string/app_name"
                android:paddingStart="20dp"
                android:adjustViewBounds="true"
                android:src="@drawable/boychar" />
        </FrameLayout>

        <!-- Videos Section -->
        <LinearLayout
            android:id="@+id/VidM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <!-- "Videos" label -->
            <TextView
                android:id="@+id/tvVideos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppinsmedium"
                android:text="@string/vid"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFF3F6" />

            <!-- "See more" label -->
            <TextView
                android:id="@+id/tvMoreVideos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_italic"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/seemore"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFF3F6" />
        </LinearLayout>

        <!-- Horizontal ScrollView for video items -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- VIDEO 1 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/vid1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="8dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardUseCompatPadding="true">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        android:src="@drawable/vid1pic" />
                </androidx.cardview.widget.CardView>

                <!-- VIDEO 2 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/vid2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="8dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardUseCompatPadding="true">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        android:src="@drawable/vid2pic" />
                </androidx.cardview.widget.CardView>

                <!-- VIDEO 4 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/vid4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="8dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardUseCompatPadding="true">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        android:src="@drawable/vid2pic" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Trivia Section Title -->
        <TextView
            android:id="@+id/tvTrivia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="18dp"
            android:text="@string/trivia"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFF3F6" />

        <!-- Trivia Cards Row 1 (cards 1 & 2) -->
        <LinearLayout
            android:id="@+id/Trivia1and2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:layout_marginBottom="4dp">

            <!-- Trivia card 1 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/trivia1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardUseCompatPadding="true">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerCrop"
                    android:src="@drawable/trivia1" />
            </androidx.cardview.widget.CardView>

            <!-- Trivia card 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/trivia2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardUseCompatPadding="true">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerCrop"
                    android:src="@drawable/trivia2" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Names for cards 1 & 2 -->
        <LinearLayout
            android:id="@+id/Trivia1and2Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="28dp">

            <TextView
                android:id="@+id/Trivia1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="32dp"
                android:text="@string/trivia1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFF3F6" />

            <TextView
                android:id="@+id/Trivia2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trivia2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFF3F6" />
        </LinearLayout>

        <!-- Trivia Cards Row 2 (cards 3 & 4) -->
        <LinearLayout
            android:id="@+id/Trivia3and4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:layout_marginBottom="4dp">

            <!-- Trivia card 3 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/trivia3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardUseCompatPadding="true">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerCrop"
                    android:src="@drawable/trivia3" />
            </androidx.cardview.widget.CardView>

            <!-- Trivia card 4 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/trivia4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardUseCompatPadding="true">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerCrop"
                    android:src="@drawable/trivia4" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Names for cards 3 & 4 -->
        <LinearLayout
            android:id="@+id/Trivia3and4Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="28dp">

            <TextView
                android:id="@+id/Trivia3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="32dp"
                android:gravity="center_horizontal"
                android:text="@string/trivia3"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFF3F6" />

            <TextView
                android:id="@+id/Trivia4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/trivia4"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFF3F6" />
        </LinearLayout>

        <!-- Add more sections as needed -->

    </LinearLayout>
</ScrollView>
